 <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource ThemeF2F2F2}"/><Setter Property="Background" Value="{DynamicResource Theme383838}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="36"/><Setter Property="Padding" Value="12,0"/><Setter Property="Margin" Value="0,0,9,8"/><Setter Property="Cursor" Value="Hand"/>
